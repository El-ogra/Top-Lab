<Window x:Class="TopLab.Presentation.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:local="clr-namespace:TopLab.Presentation"
         xmlns:usersVm="clr-namespace:TopLab.Presentation.ViewModels.Users"
         xmlns:usersView="clr-namespace:TopLab.Presentation.Views.Users"
         xmlns:settingsVm="clr-namespace:TopLab.Presentation.ViewModels.Settings"
         xmlns:settingsView="clr-namespace:TopLab.Presentation.Views.Settings"
          xmlns:patientsVm="clr-namespace:TopLab.Presentation.ViewModels.Patients"
          xmlns:patientsView="clr-namespace:TopLab.Presentation.Views.Patients"
          xmlns:labVm="clr-namespace:TopLab.Presentation.ViewModels.Lab"
          xmlns:labView="clr-namespace:TopLab.Presentation.Views.Lab"
           xmlns:externalVm="clr-namespace:TopLab.Presentation.ViewModels.External"
           xmlns:externalView="clr-namespace:TopLab.Presentation.Views.External"
           xmlns:sheetsVm="clr-namespace:TopLab.Presentation.ViewModels.WorkSheets"
           xmlns:sheetsView="clr-namespace:TopLab.Presentation.Views.WorkSheets"
           xmlns:attendanceVm="clr-namespace:TopLab.Presentation.ViewModels.Attendance"
           xmlns:attendanceView="clr-namespace:TopLab.Presentation.Views.Attendance"
           xmlns:statisticsVm="clr-namespace:TopLab.Presentation.ViewModels.Statistics"
           xmlns:statisticsView="clr-namespace:TopLab.Presentation.Views.Statistics"
           xmlns:accountsVm="clr-namespace:TopLab.Presentation.ViewModels.Accounts"
           xmlns:accountsView="clr-namespace:TopLab.Presentation.Views.Accounts"
           xmlns:auditVm="clr-namespace:TopLab.Presentation.ViewModels.Audit"
           xmlns:auditView="clr-namespace:TopLab.Presentation.Views.Audit"
           xmlns:utilitiesVm="clr-namespace:TopLab.Presentation.ViewModels.Utilities"
           xmlns:utilitiesView="clr-namespace:TopLab.Presentation.Views.Utilities"
         mc:Ignorable="d"
         Title="Top-Lab — نظام توب لاب" Height="600" Width="1024"
         FlowDirection="RightToLeft"
         WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#1E3A5F">
            <ItemsControl ItemsSource="{Binding NavigationItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}" Command="{Binding Command}" IsEnabled="{Binding IsEnabled}" Margin="4" Padding="8,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <Button Content="{Binding CurrentUserName}" Command="{Binding OpenChangePasswordCommand}"
                        Background="Transparent" BorderThickness="0" Padding="2,0" Cursor="Hand" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding LastLoginText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" ToolTip="{Binding DatabaseConnectivityTooltip}">
                    <Ellipse Width="10" Height="10" Margin="0,0,4,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Gray" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsConnectionStatusKnown}" Value="True" />
                                            <Condition Binding="{Binding IsDatabaseConnected}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Fill" Value="Green" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsConnectionStatusKnown}" Value="True" />
                                            <Condition Binding="{Binding IsDatabaseConnected}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Fill" Value="Red" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding DatabaseConnectivityText}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding CurrentDateTime, StringFormat={}{0:G}}" FlowDirection="LeftToRight" />
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <ContentControl Content="{Binding CurrentViewModel}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type local:ViewModels.Shell.HomeViewModel}">
                        <StackPanel Margin="20">
                            <TextBlock Text="Top-Lab — لوحة التحكم" FontSize="20" Margin="0,0,0,16"/>
                            <WrapPanel>
                                <Button Content="إضافة وتعديل بيانات المرضى" Margin="4" Padding="16,8"/>
                                <Button Content="إدخال نتائج التحاليل" Margin="4" Padding="16,8"/>
                                <Button Content="بحث عن مريض" Margin="4" Padding="16,8"/>
                                <Button Content="تسليم نتائج المرضى" Margin="4" Padding="16,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type patientsVm:PatientsHubViewModel}">
                        <patientsView:PatientsHubView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type patientsVm:PatientEditorViewModel}">
                        <patientsView:PatientEditorView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type patientsVm:PatientAccountViewModel}">
                                            <patientsView:PatientAccountView/>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type patientsVm:ResultsWorklistViewModel}">
                                                                                <patientsView:ResultsWorklistView/>
                                                                            </DataTemplate>

                                                                            <DataTemplate DataType="{x:Type patientsVm:SimpleResultEntryViewModel}">
                                                                                                                                                            <patientsView:SimpleResultEntryView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type patientsVm:PatientResultSheetViewModel}">
                                                                                                                                                            <patientsView:PatientResultSheetView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type patientsVm:ProfileEntryViewModel}">
                                                                                                                                                            <patientsView:ProfileEntryView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type patientsVm:CultureEntryViewModel}">
                                                                                                                                                            <patientsView:CultureEntryView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type patientsVm:PatientSearchViewModel}">
                                                                                                                                                            <patientsView:PatientSearchView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type patientsVm:PatientVisitHistoryViewModel}">
                                                                                                                                                            <patientsView:PatientVisitHistoryView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type patientsVm:CombinedReportViewModel}">
                                                                                                                                                            <patientsView:CombinedReportView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type patientsVm:BlankReportViewModel}">
                                                                                                                                                            <patientsView:BlankReportView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type patientsVm:HistoryReportsViewModel}">
                                                                                                                                                            <patientsView:HistoryReportsView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type patientsVm:ResultDeliveryViewModel}">
                                                                                                                                                            <patientsView:ResultDeliveryView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type patientsVm:DeliveryHandoverViewModel}">
                                                                                                                                                            <patientsView:DeliveryHandoverView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type patientsVm:SentOutSamplesViewModel}">
                                                                                                                                                            <patientsView:SentOutSamplesView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type patientsVm:SentOutLabAccountViewModel}">
                                                                                                                                                            <patientsView:SentOutLabAccountView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type attendanceVm:MyAttendanceViewModel}">
                                                                                                                                                            <attendanceView:MyAttendanceView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type attendanceVm:AttendanceRecordsViewModel}">
                                                                                                                                                            <attendanceView:AttendanceRecordsView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type attendanceVm:UserAttendanceSummaryViewModel}">
                                                                                                                                                            <attendanceView:UserAttendanceSummaryView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type statisticsVm:StatisticsViewModel}">
                                                                                                                                                            <statisticsView:StatisticsView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type accountsVm:AccountsHubViewModel}">
                                                                                                                                                            <accountsView:AccountsHubView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type auditVm:AuditViewModel}">
                                                                                                                                                            <auditView:AuditView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type utilitiesVm:UtilitiesViewModel}">
                                                                                                                                                            <utilitiesView:UtilitiesView/>
                                                                                                                                                        </DataTemplate>

                                                                                                                                                        <DataTemplate DataType="{x:Type sheetsVm:WorkSheetsViewModel}">
                        <sheetsView:WorkSheetsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type labVm:LabHubViewModel}">
                        <labView:LabHubView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type labVm:TestCatalogViewModel}">
                        <labView:TestCatalogView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type labVm:TestGroupsViewModel}">
                        <labView:TestGroupsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type labVm:WorkGroupLogsViewModel}">
                        <labView:WorkGroupLogsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type labVm:AnalytesViewModel}">
                        <labView:AnalytesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type labVm:ProfilesViewModel}">
                        <labView:ProfilesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type labVm:AntibioticsViewModel}">
                        <labView:AntibioticsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type labVm:CultureAttachmentViewModel}">
                        <labView:CultureAttachmentView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type labVm:PriceListsViewModel}">
                        <labView:PriceListsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type labVm:TestCommentsViewModel}">
                        <labView:TestCommentsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type labVm:CustomGroupsViewModel}">
                        <labView:CustomGroupsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type labVm:SampleCollectionViewModel}">
                        <labView:SampleCollectionView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type externalVm:ExternalEntitiesViewModel}">
                        <externalView:ExternalEntitiesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type usersVm:UserManagementViewModel}">
                        <usersView:UserManagementView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type settingsVm:SettingsDashboardViewModel}">
                        <settingsView:SettingsDashboardView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type settingsVm:SystemSettingsViewModel}">
                        <settingsView:SystemSettingsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type settingsVm:ReportSettingsViewModel}">
                        <settingsView:ReportSettingsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type settingsVm:ReceiptSettingsViewModel}">
                        <settingsView:ReceiptSettingsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type settingsVm:EnvelopeSettingsViewModel}">
                        <settingsView:EnvelopeSettingsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type settingsVm:DatabaseMaintenanceViewModel}">
                        <settingsView:DatabaseMaintenanceView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </DockPanel>
</Window>
