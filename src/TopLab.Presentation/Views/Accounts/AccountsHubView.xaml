<UserControl x:Class="TopLab.Presentation.Views.Accounts.AccountsHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tab selector -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton Content="جرد درج النقدية" IsChecked="{Binding IsCashDrawerTab}" GroupName="AccountsTab" Margin="0,0,8,0"/>
            <RadioButton Content="جرد العناصر" IsChecked="{Binding IsElementInventoryTab}" GroupName="AccountsTab" Margin="0,0,8,0"/>
            <RadioButton Content="عينات المرضى" IsChecked="{Binding IsPatientSamplesTab}" GroupName="AccountsTab" Margin="0,0,8,0"/>
            <RadioButton Content="حسابات الشركات" IsChecked="{Binding IsCompanyDelegateTab}" GroupName="AccountsTab"/>
        </StackPanel>

        <!-- Period + actions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding From, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,8,0"/>
            <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding To, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,8,0"/>
            <Button Content="عرض" Width="70" Margin="0,0,8,0" Command="{Binding LoadCommand}"/>
            <Button Content="إيداع" Width="70" Margin="0,0,6,0" Command="{Binding OpenDepositCommand}"/>
            <Button Content="صرف" Width="70" Margin="0,0,6,0" Command="{Binding OpenDisbursementCommand}"/>
            <Button Content="رجوع" Width="70" Command="{Binding BackCommand}"/>
        </StackPanel>

        <!-- Loading -->
        <ProgressBar Grid.Row="2" Height="6" IsIndeterminate="True" Margin="0,0,0,8">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Tab content -->
        <Grid Grid.Row="3">
            <!-- Cash Drawer Tab -->
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCashDrawerTab}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Balance card -->
                        <Border Background="#F0F4F8" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="بطاقة الرصيد" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Drawer.TotalSamplesCount, StringFormat='إجمالي العينات (عدد): {0}'}"/>
                                <TextBlock Text="{Binding Drawer.TotalSamplesAmount, StringFormat='إجمالي العينات (مبلغ): {0}'}"/>
                                <TextBlock Text="{Binding Drawer.DiscountsValue, StringFormat='قيمة الخصومات: {0}'}"/>
                                <TextBlock Text="{Binding Drawer.TotalAfterDiscount, StringFormat='الإجمالي بعد الخصم: {0}'}"/>
                                <TextBlock Text="{Binding Drawer.CollectedAmount, StringFormat='ما تم سداده: {0}'}"/>
                                <TextBlock Text="{Binding Drawer.UncollectedAmount, StringFormat='باقي لم يسدد: {0}'}"/>
                                <TextBlock Text="{Binding Drawer.CashSupplies, StringFormat='توريدات نقدية: {0}'}"/>
                                <TextBlock Text="{Binding Drawer.Disbursements, StringFormat='المصروفات: {0}'}"/>
                                <TextBlock Text="{Binding Drawer.SafeCash, StringFormat='المتاح في الخزينة: {0}'}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Drawer.SentOutCount, StringFormat='العينات المرسلة (عدد): {0}'}"/>
                                <TextBlock Text="{Binding Drawer.SentOutTotalCost, StringFormat='تكلفة المرسلة: {0}'}"/>
                                <TextBlock Text="{Binding Drawer.SentOutTotalPaid, StringFormat='المدفوع للمرسلة: {0}'}"/>
                                <TextBlock Text="{Binding Drawer.SentOutRemaining, StringFormat='المتبقي للمرسلة: {0}'}"/>
                                <TextBlock Text="{Binding Drawer.RemainingToLab, StringFormat='باقي للمعمل: {0}'}"/>
                                <TextBlock Text="{Binding Drawer.NetProfit, StringFormat='صافي الربح: {0}'}" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <!-- Movements table -->
                        <TextBlock Text="لا توجد حركات نقدية في هذه الفترة." Foreground="#666666" Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowMovementsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding OccurredAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130"/>
                                <DataGridTextColumn Header="النوع" Binding="{Binding MovementType}" Width="80"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount}" Width="80"/>
                                <DataGridTextColumn Header="الجهة" Binding="{Binding RelatedExternalEntityName}" Width="120"/>
                                <DataGridTextColumn Header="بواسطة" Binding="{Binding PerformedByName}" Width="100"/>
                                <DataGridTextColumn Header="البيان" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Other tabs placeholder (Slices 4) -->
            <TextBlock Text="جرد العناصر — سيتم تنفيذه في الشريحة 4." Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsElementInventoryTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="عينات المرضى — سيتم تنفيذه في الشريحة 4." Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPatientSamplesTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="حسابات الشركات — سيتم تنفيذه في الشريحة 4." Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompanyDelegateTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Messages -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="Green" Margin="0,4,0,0"/>
        <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </Grid>
</UserControl>
