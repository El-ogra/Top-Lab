<UserControl x:Class="TopLab.Presentation.Views.Settings.ReportItemTemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="960" HorizontalAlignment="Center">

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="القائمة الرئيسية" Width="110" Margin="8,0,0,0"
                        Command="{Binding BackToDashboardCommand}" />
                <TextBlock Text="عناصر التقرير" FontSize="20" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="يمكن تعديل التسمية والتعبير المرجعي وإظهار العنصر وعضوية القائمة وكونه نصاً حراً."
                       Foreground="#666666" TextWrapping="Wrap" Margin="0,8,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="العنصر" FontWeight="Bold" Margin="0,4,8,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="التسمية" FontWeight="Bold" Margin="0,4,8,4" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="التعبير المرجعي" FontWeight="Bold" Margin="0,4,8,4" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="ظاهر" FontWeight="Bold" Margin="0,4,8,4" />
                <TextBlock Grid.Row="0" Grid.Column="4" Text="عضوية القائمة" FontWeight="Bold" Margin="0,4,8,4" />
                <TextBlock Grid.Row="0" Grid.Column="5" Text="نص حر" FontWeight="Bold" Margin="0,4,8,4" />

                <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Caption}" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" />
                                <TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Margin="0,0,8,0" Text="{Binding ReferenceValueExpression, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Grid.Column="3" IsChecked="{Binding ShowHide}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="4" Margin="0,0,8,0" Text="{Binding ListMembership, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Grid.Column="5" IsChecked="{Binding FreeTextOverride}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#1E3A5F" TextWrapping="Wrap" Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,20,0,8">
                <Button Content="حفظ" Width="120" Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
