<UserControl x:Class="TopLab.Presentation.Views.Utilities.UtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tab selector -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton Content="الآلة الحاسبة" IsChecked="{Binding IsCalculatorTab}" GroupName="UtilTab" Margin="0,0,6,0"/>
            <RadioButton Content="محوّل الوحدات" IsChecked="{Binding IsConverterTab}" GroupName="UtilTab" Margin="0,0,6,0"/>
            <RadioButton Content="ساعة الإيقاف" IsChecked="{Binding IsStopwatchTab}" GroupName="UtilTab" Margin="0,0,6,0"/>
            <RadioButton Content="دفتر الهواتف" IsChecked="{Binding IsPhoneBookTab}" GroupName="UtilTab" Margin="0,0,6,0"/>
            <RadioButton Content="قائمة المشتريات" IsChecked="{Binding IsPurchasesTab}" GroupName="UtilTab" Margin="0,0,6,0"/>
            <RadioButton Content="مكتبة التحاليل" IsChecked="{Binding IsTestLibraryTab}" GroupName="UtilTab"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="رجوع" Width="70" Command="{Binding BackCommand}"/>
        </StackPanel>

        <!-- Loading -->
        <ProgressBar Grid.Row="2" Height="6" IsIndeterminate="True" Margin="0,0,0,8">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Tab content -->
        <Grid Grid.Row="3">
            <!-- Calculator -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCalculatorTab}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="التعبير:" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                <Button Content="احسب" Width="80" Command="{Binding EvaluateCommand}"/>
                <TextBlock Text="{Binding CalcResult, StringFormat='النتيجة: {0}'}" FontSize="16" FontWeight="Bold" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Converter -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConverterTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="القيمة:" Margin="0,0,0,2"/>
                <TextBox Text="{Binding ConvertValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                <TextBlock Text="من وحدة:" Margin="0,0,0,2"/>
                <TextBox Text="{Binding FromUnit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                <TextBlock Text="إلى وحدة:" Margin="0,0,0,2"/>
                <TextBox Text="{Binding ToUnit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                <Button Content="تحويل" Width="80" Command="{Binding ConvertCommand}"/>
                <TextBlock Text="{Binding ConvertResult, StringFormat='النتيجة: {0}'}" FontSize="16" FontWeight="Bold" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Stopwatch (D11: all elapsed via query) -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStopwatchTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="وقت البداية (UTC):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding StopwatchStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                <TextBlock Text="وقت النهاية (UTC، اختياري):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding StopwatchEnd, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                <Button Content="احسب المنقضي" Width="100" Command="{Binding ComputeStopwatchCommand}"/>
                <TextBlock Text="{Binding StopwatchResult, StringFormat='المنقضي: {0}'}" FontSize="16" FontWeight="Bold" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Phone book -->
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPhoneBookTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="الاسم:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding PhoneBookName, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,4,0"/>
                    <TextBlock Text="الهاتف:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding PhoneBookPhone, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,4,0"/>
                    <TextBlock Text="ملاحظات:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding PhoneBookNotes, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,4,0"/>
                    <Button Content="إضافة" Width="60" Command="{Binding AddPhoneBookCommand}"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding PhoneBook}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="120"/>
                        <DataGridTemplateColumn Header="" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="حذف" Padding="4,2"
                                            Command="{Binding DataContext.RemovePhoneBookCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Purchases -->
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPurchasesTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="البند:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding PurchaseText, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,4,0"/>
                    <Button Content="إضافة" Width="60" Command="{Binding AddPurchaseCommand}"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Purchases}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="تم" Binding="{Binding IsDone}" Width="40"/>
                        <DataGridTextColumn Header="البند" Binding="{Binding Text}" Width="*"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAtUtc, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                        <DataGridTemplateColumn Header="" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="تبديل" Padding="4,2" Margin="0,0,4,0"
                                                Command="{Binding DataContext.TogglePurchaseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="حذف" Padding="4,2"
                                                Command="{Binding DataContext.RemovePurchaseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Test library -->
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTestLibraryTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="بحث:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding TestLibraryFilter, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,4,0"/>
                    <Button Content="عرض" Width="60" Command="{Binding LoadTestLibraryCommand}"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding TestLibrary}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التحليل" Binding="{Binding TestName}" Width="*"/>
                        <DataGridTextColumn Header="الرمز" Binding="{Binding TestCode}" Width="80"/>
                        <DataGridTextColumn Header="المجموعة" Binding="{Binding GroupName}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <!-- Messages -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="Green" Margin="0,4,0,0"/>
        <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </Grid>
</UserControl>
