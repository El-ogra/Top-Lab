<Window x:Class="TopLab.Presentation.Views.External.ExternalEntityPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اختيار جهة" Height="480" Width="640"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="اختيار" Width="90" Margin="0,0,8,0" Click="PickButton_Click"
                    IsEnabled="{Binding HasSelection}" IsDefault="True" />
            <Button Content="إلغاء" Width="80" Click="CancelButton_Click" IsCancel="True" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Width="220" Margin="0,0,8,0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="170" Margin="0,0,8,0" ItemsSource="{Binding TypeFilters}"
                      SelectedItem="{Binding SelectedTypeFilter}" DisplayMemberPath="Label" />
            <Button Content="بحث" Width="80" Command="{Binding SearchCommand}" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedEntity}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الكود" Binding="{Binding GeneratedIdCode}" Width="100" />
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="النوع" Binding="{Binding EntityType}" Width="120" />
                <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
