<UserControl x:Class="TopLab.Presentation.Views.External.ExternalEntitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="الجهات الخارجية" FontSize="20" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Width="220" Margin="0,0,8,0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="170" Margin="0,0,8,0" ItemsSource="{Binding TypeFilters}"
                      SelectedItem="{Binding SelectedTypeFilter}" DisplayMemberPath="Label" />
            <Button Content="بحث" Width="80" Margin="0,0,8,0" Command="{Binding LoadEntitiesCommand}" />
            <Button Content="جهة جديدة" Width="100" Command="{Binding OpenCreateCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="لا جهات مطابقة للبحث" Foreground="#666666" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#1E3A5F" Margin="0,4,0,0" />

        <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الكود" Binding="{Binding GeneratedIdCode}" Width="100" />
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="النوع" Binding="{Binding EntityType}" Width="120" />
                <DataGridTextColumn Header="المدينة" Binding="{Binding City}" Width="120" />
                <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120" />
                <DataGridTemplateColumn Header="إجراءات" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="تعديل" Width="60" Margin="2"
                                        Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="حذف" Width="60" Margin="2"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
