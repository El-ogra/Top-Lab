<UserControl x:Class="TopLab.Presentation.Views.Lab.TestGroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="اسم المجموعة:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="220" Margin="0,0,8,0" Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="جديد" Width="70" Margin="0,0,8,0" Command="{Binding NewCommand}" />
            <Button Content="حفظ" Width="80" Command="{Binding SaveCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#1E3A5F" Margin="0,4,0,0" />

        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Group.IsActive}" Value="False">
                            <Setter Property="Foreground" Value="Gray" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="الاسم" Binding="{Binding Group.Name}" Width="*" />
                <DataGridTextColumn Header="عدد التحاليل" Binding="{Binding TestCount}" Width="100" />
                <DataGridTemplateColumn Header="الحالة" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="نشطة" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Group.IsActive}" Value="False">
                                                <Setter Property="Text" Value="معطَّلة" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="إجراءات" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="تعطيل/تفعيل" Width="100" Margin="2"
                                    Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
