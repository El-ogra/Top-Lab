<UserControl x:Class="TopLab.Presentation.Views.Lab.TestCommentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="التحليل:" Margin="0,0,0,2" />
            <ComboBox ItemsSource="{Binding CatalogTests}" SelectedItem="{Binding PickedTest}"
                      DisplayMemberPath="Name" Margin="0,0,0,8" />
            <TextBlock Text="نص التعليق:" Margin="0,0,0,2" />
            <TextBox Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                     Height="70" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <Button Content="جديد" Width="80" Margin="0,0,8,0" Command="{Binding NewCommand}" />
                <Button Content="حفظ" Width="80" Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#1E3A5F" Margin="0,4,0,0" />

        <DataGrid ItemsSource="{Binding Comments}" SelectedItem="{Binding SelectedComment}"
                  AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="التحليل" Binding="{Binding TestName}" Width="200" />
                <DataGridTextColumn Header="التعليق" Binding="{Binding CommentText}" Width="*" />
                <DataGridTemplateColumn Header="" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="حذف" Width="60" Margin="2"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
