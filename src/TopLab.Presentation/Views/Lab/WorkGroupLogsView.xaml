<UserControl x:Class="TopLab.Presentation.Views.Lab.WorkGroupLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock DockPanel.Dock="Top" Text="السجلات" FontWeight="Bold" Margin="0,0,0,8" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="جديد" Width="70" Margin="0,0,8,0" Command="{Binding NewCommand}" />
                <Button Content="حفظ السجل" Width="90" Command="{Binding SaveLogCommand}" />
            </StackPanel>
            <TextBox DockPanel.Dock="Bottom" Margin="0,8,0,0" Text="{Binding LogName, UpdateSourceTrigger=PropertyChanged}" />
            <ListBox ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}" DisplayMemberPath="Name" />
        </DockPanel>

        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="بنود السجل" FontWeight="Bold" Margin="0,0,0,8" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox Width="220" Margin="0,0,8,0" ItemsSource="{Binding CatalogTests}"
                          SelectedItem="{Binding PickedTest}" DisplayMemberPath="Name" />
                <Button Content="إضافة" Width="80" Margin="0,0,8,0" Command="{Binding AddItemCommand}" />
                <Button Content="حفظ البنود" Width="100" Command="{Binding SaveItemsCommand}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#1E3A5F" Margin="0,4,0,0" />
            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التحليل" Binding="{Binding TestName}" Width="*" />
                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="إزالة" Width="60" Margin="2"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
