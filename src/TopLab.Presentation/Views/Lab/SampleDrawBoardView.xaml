<UserControl x:Class="TopLab.Presentation.Views.Lab.SampleDrawBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TopLab.Presentation.Common.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <DockPanel Margin="16">
        <!-- Patient header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="سحب العينات — المريض" FontSize="18" Margin="0,0,0,4" />
            <TextBlock Margin="0,0,0,2">
                <Run Text="المريض:" FontWeight="Bold" />
                <Run Text="{Binding FullName}" />
            </TextBlock>
            <TextBlock Margin="0,0,0,0">
                <Run Text="Lab ID:" FontWeight="Bold" />
                <Run Text="{Binding LabId}" />
            </TextBlock>
        </StackPanel>

        <!-- Loading indicator -->
        <ProgressBar DockPanel.Dock="Top" Height="6" IsIndeterminate="True" Margin="0,4,0,0">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Bulk action -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,8">
            <Button Content="سحب الكل" Width="110" Command="{Binding MarkAllCommand}" />
            <Button Content="إعادة التحميل" Width="110" Margin="8,0,0,0" Command="{Binding ReloadCommand}" />
            <Button Content="حذف" Width="90" Margin="8,0,0,0" Command="{Binding RemoveCommand}" />
            <Button Content="حفظ عينات المريض" Width="130" Margin="8,0,0,0" Command="{Binding SaveCommand}" />
            <Button Content="طباعة كل الملصقات" Width="130" Margin="8,0,0,0" Command="{Binding PrintAllCommand}" />
            <Button Content="طباعة (سيرم/بلازما/دم)" Width="150" Margin="8,0,0,0" Command="{Binding PrintBloodCommand}" />
            <Button Content="طباعة (سائل منوي/بول/براز)" Width="170" Margin="8,0,0,0" Command="{Binding PrintBodyFluidsCommand}" />
        </StackPanel>

        <!-- Status strip -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                   Foreground="#1E3A5F" TextWrapping="Wrap" Margin="0,4,0,0" />

        <!-- Error strip -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}"
                   Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,0" />

        <!-- 8.2.1.10 Date Picker Block (Step Calendar) -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,8">
            <Button Content="◄" Width="40" Command="{Binding PreviousMonthCommand}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding MonthLabel}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" />
            <Button Content="►" Width="40" Command="{Binding NextMonthCommand}" Margin="0,0,8,0" />
            <Calendar SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding SelectedDate, StringFormat='اليوم: {0:dd/MM/yyyy}'}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <!-- Two-grid layout: not-drawn (left) + drawn (right) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Not-drawn grid with CheckBox -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="غير مسحوبة" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Text="لا توجد عينات غير مسحوبة" Foreground="#666666" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AnyNotDrawn}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <DataGrid ItemsSource="{Binding NotDrawnRows}" AutoGenerateColumns="False"
                          IsReadOnly="True" Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding Dto.IsTakenOutsideLab, Converter={StaticResource InverseBool}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="تحليل" Binding="{Binding Dto.TestName}" Width="*" />
                        <DataGridTextColumn Header="الرمز" Binding="{Binding Dto.TestId, StringFormat={}{0}}" Width="70" />
                        <DataGridTemplateColumn Header="النوع" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="بول" Margin="0,0,4,0" Visibility="{Binding Dto.IsUrine, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="براز" Margin="0,0,4,0" Visibility="{Binding Dto.IsStool, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="دم" Margin="0,0,4,0" Visibility="{Binding Dto.IsBlood, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="semen" Margin="0,0,4,0" Visibility="{Binding Dto.IsSemen, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="CSF" Margin="0,0,4,0" Visibility="{Binding Dto.IsCsf, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="خارج المعمل" Binding="{Binding Dto.IsTakenOutsideLab}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Drawn grid (read-only, with timestamp) -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="مسحوبة" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Text="لا توجد عينات مسحوبة بعد" Foreground="#666666" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AnyDrawn}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <DataGrid ItemsSource="{Binding DrawnRows}" AutoGenerateColumns="False"
                          IsReadOnly="True" Margin="0,0,0,8" SelectedItem="{Binding SelectedDrawn}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تحليل" Binding="{Binding Dto.TestName}" Width="*" />
                        <DataGridTextColumn Header="الرمز" Binding="{Binding Dto.TestId, StringFormat={}{0}}" Width="70" />
                        <DataGridTextColumn Header="تاريخ السحب" Binding="{Binding Dto.SampleDrawnAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150" />
                        <DataGridTemplateColumn Header="النوع" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="بول" Margin="0,0,4,0" Visibility="{Binding Dto.IsUrine, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="براز" Margin="0,0,4,0" Visibility="{Binding Dto.IsStool, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="دم" Margin="0,0,4,0" Visibility="{Binding Dto.IsBlood, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="semen" Margin="0,0,4,0" Visibility="{Binding Dto.IsSemen, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="CSF" Margin="0,0,4,0" Visibility="{Binding Dto.IsCsf, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="خارج المعمل" Binding="{Binding Dto.IsTakenOutsideLab}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
