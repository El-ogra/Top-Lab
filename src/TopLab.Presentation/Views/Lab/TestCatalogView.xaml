<UserControl x:Class="TopLab.Presentation.Views.Lab.TestCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Width="220" Margin="0,0,8,0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="180" Margin="0,0,8,0" ItemsSource="{Binding GroupFilters}"
                      SelectedItem="{Binding SelectedGroupFilter}" DisplayMemberPath="Name" />
            <Button Content="بحث" Width="80" Margin="0,0,8,0" Command="{Binding LoadCatalogCommand}" />
            <Button Content="تحليل جديد" Width="100" Command="{Binding OpenCreateCommand}" />
            <TextBlock Text="{Binding TotalCount, StringFormat=الإجمالي: {0}}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="لا توجد تحاليل مطابقة" Foreground="#666666" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowFilteredEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border DockPanel.Dock="Top" BorderBrush="Red" BorderThickness="1" Padding="12" Margin="0,8,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowCriticalEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="لا يمكن تسجيل مريض قبل إدخال التحاليل" Foreground="Red" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <Button Content="إضافة أول تحليل" Width="140" HorizontalAlignment="Left"
                        Command="{Binding OpenCreateCommand}" />
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />

        <DataGrid ItemsSource="{Binding Summaries}" AutoGenerateColumns="False" IsReadOnly="True"
                  Margin="0,8,0,0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                            <Setter Property="Foreground" Value="Gray" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="الكود" Binding="{Binding TestCode}" Width="80" />
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="المجموعة" Binding="{Binding TestGroupName}" Width="120" />
                <DataGridTextColumn Header="السعر" Binding="{Binding PatientPrice}" Width="80" />
                <DataGridTemplateColumn Header="الحالة" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="نشط" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Text" Value="معطَّل" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="إجراءات" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="تعديل" Width="60" Margin="2"
                                        Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="تعطيل/تفعيل" Width="90" Margin="2"
                                        Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
