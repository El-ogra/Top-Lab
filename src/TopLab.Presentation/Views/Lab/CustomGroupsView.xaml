<UserControl x:Class="TopLab.Presentation.Views.Lab.CustomGroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock DockPanel.Dock="Top" Text="المجموعات المخصصة" FontWeight="Bold" Margin="0,0,0,8" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="جديد" Width="70" Margin="0,0,8,0" Command="{Binding NewCommand}" />
                <Button Content="حفظ" Width="70" Margin="0,0,8,0" Command="{Binding SaveGroupCommand}" />
                <Button Content="حذف" Width="70" Command="{Binding DeleteGroupCommand}" />
            </StackPanel>
            <TextBox DockPanel.Dock="Bottom" Margin="0,8,0,0" Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" />
            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" />
        </DockPanel>

        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="بنود المجموعة" FontWeight="Bold" Margin="0,0,0,8" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox Width="220" Margin="0,0,8,0" ItemsSource="{Binding CatalogTests}"
                          SelectedItem="{Binding PickedTest}" DisplayMemberPath="Name" />
                <TextBox Width="100" Margin="0,0,8,0" Text="{Binding NewItemPrice, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="إضافة" Width="80" Command="{Binding AddItemCommand}" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="مجموعة بلا تحاليل" Foreground="#666666" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowItemsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#1E3A5F" Margin="0,4,0,0" />

            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" Margin="0,8,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التحليل" Binding="{Binding Item.TestName}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="الكود" Binding="{Binding Item.TestCode}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="السعر" Binding="{Binding EditPrice, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                    <DataGridTemplateColumn Header="" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="حفظ" Width="60" Margin="2"
                                            Command="{Binding DataContext.SaveItemPriceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="إزالة" Width="60" Margin="2"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="محفوظ" Foreground="Green" FontWeight="Bold" Margin="2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
