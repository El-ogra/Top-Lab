<Window x:Class="TopLab.Presentation.Views.Lab.AntibioticEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بيانات المضاد الحيوي" Height="280" Width="440"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="حفظ" Width="90" Margin="0,0,8,0" Click="SaveButton_Click" IsDefault="True" />
            <Button Content="إلغاء" Width="80" Click="CancelButton_Click" IsCancel="True" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel>
            <TextBlock Text="الاسم:" Margin="0,0,0,2" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
            <CheckBox Content="معلَّم للحوامل" IsChecked="{Binding IsPregnancyFlagged}" Margin="0,0,0,8" />
            <CheckBox Content="معلَّم للأطفال" IsChecked="{Binding IsChildrenFlagged}" />
        </StackPanel>
    </DockPanel>
</Window>
