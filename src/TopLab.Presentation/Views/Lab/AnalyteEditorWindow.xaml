<Window x:Class="TopLab.Presentation.Views.Lab.AnalyteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بيانات المكوّن التحليلي" Height="560" Width="720"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="حفظ" Width="100" Margin="0,0,8,0" Command="{Binding SaveCommand}" IsDefault="True" />
            <Button Content="إغلاق" Width="90" Click="CloseButton_Click" IsCancel="True" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />

        <TabControl>
            <TabItem Header="بيانات المكوّن">
                <StackPanel Margin="8">
                    <TextBlock Text="الاسم:" Margin="0,4,0,2" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <TextBlock Text="اسم التقرير:" Margin="0,4,0,2" />
                    <TextBox Text="{Binding ReportName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                </StackPanel>
            </TabItem>
            <TabItem Header="النطاقات">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="صف جديد" Width="90" Margin="0,0,8,0" Command="{Binding AddBandCommand}" />
                        <Button Content="حذف الصف" Width="90" Margin="0,0,8,0" Command="{Binding RemoveBandCommand}" />
                        <Button Content="حفظ النطاقات" Width="110" Command="{Binding SaveBandsCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Bands}" SelectedItem="{Binding SelectedBand}"
                              AutoGenerateColumns="False" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="من (سن)" Binding="{Binding AgeMin}" Width="60" />
                            <DataGridTextColumn Header="إلى (سن)" Binding="{Binding AgeMax}" Width="60" />
                            <DataGridTemplateColumn Header="الوحدة" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AgeUnitOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding AgeUnit, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="الجنس" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.SexOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Sex, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="الأدنى" Binding="{Binding MinValue}" Width="70" />
                            <DataGridTextColumn Header="الأعلى" Binding="{Binding MaxValue}" Width="70" />
                            <DataGridTextColumn Header="تعليق منخفض" Binding="{Binding LowComment}" Width="*" />
                            <DataGridTextColumn Header="تعليق مرتفع" Binding="{Binding HighComment}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
