<UserControl x:Class="TopLab.Presentation.Views.Lab.MedicalConditionTypesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="الاسم:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="220" Margin="0,0,8,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="150" Margin="0,0,8,0" ItemsSource="{Binding CategoryOptions}"
                      SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label" />
            <Button Content="إضافة" Width="80" Margin="0,0,8,0" Command="{Binding AddCommand}" />
            <Button Content="حفظ الاسم" Width="90" Command="{Binding RenameCommand}"
                    IsEnabled="{Binding CanRenameSelected}" />
            <Button Content="تحديث" Width="70" Margin="8,0,0,0" Command="{Binding LoadCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#1E3A5F" Margin="0,4,0,0" />
        <TextBlock DockPanel.Dock="Bottom" Foreground="#666666" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="الأنواع المدمجة (المربعة في السطر) لا يمكن تعديلها أو حذفها." />

        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSeeded}" Value="True">
                            <Setter Property="Foreground" Value="#666666" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="الرقم" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="التصنيف" Binding="{Binding CategoryLabel}" Width="140" />
                <DataGridTemplateColumn Header="مدمج" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="نعم">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSeeded}" Value="True">
                                                <Setter Property="Text" Value="نعم" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
