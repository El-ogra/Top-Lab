<Window x:Class="TopLab.Presentation.Views.Lab.TestEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TopLab.Presentation.Common.Converters"
        Title="بيانات التحليل" Height="640" Width="720"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBool" />
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="حفظ" Width="100" Margin="0,0,8,0" Command="{Binding SaveCommand}" IsDefault="True" />
            <Button Content="إغلاق" Width="90" Click="CloseButton_Click" IsCancel="True" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />

        <TabControl>
            <TabItem Header="بيانات التحليل">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="كود التحليل:" VerticalAlignment="Center" Margin="0,4,8,4" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding TestCode}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="الاسم:" VerticalAlignment="Center" Margin="8,4,8,4" />
                        <TextBox Grid.Row="0" Grid.Column="3" Margin="0,4" Text="{Binding Name}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="اسم التقرير:" VerticalAlignment="Center" Margin="0,4,8,4" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding ReportName}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="اسم الإيصال:" VerticalAlignment="Center" Margin="8,4,8,4" />
                        <TextBox Grid.Row="1" Grid.Column="3" Margin="0,4" Text="{Binding ReceiptName}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="المجموعة:" VerticalAlignment="Center" Margin="0,4,8,4" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Groups}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TestGroupId}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="الباركود:" VerticalAlignment="Center" Margin="8,4,8,4" />
                        <TextBox Grid.Row="2" Grid.Column="3" Margin="0,4" Text="{Binding Barcode}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="مدة الإنجاز (دقيقة):" VerticalAlignment="Center" Margin="0,4,8,4" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding CompletionDurationMinutes}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="نوع النتيجة:" VerticalAlignment="Center" Margin="8,4,8,4" />
                        <ComboBox Grid.Row="3" Grid.Column="3" Margin="0,4" ItemsSource="{Binding ResultKindOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ResultKind}"
                                  IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBool}}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="سعر المريض:" VerticalAlignment="Center" Margin="0,4,8,4" />
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4" Text="{Binding PatientPrice}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="سعر من معمل:" VerticalAlignment="Center" Margin="8,4,8,4" />
                        <TextBox Grid.Row="4" Grid.Column="3" Margin="0,4" Text="{Binding LabToLabPrice}" />

                        <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="تحليل مزرعة" Margin="0,8,0,0"
                                  IsChecked="{Binding IsCultureType}"
                                  IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBool}}" />
                        <CheckBox Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Content="صادر لمعمل خارجي" Margin="8,8,0,0"
                                  IsChecked="{Binding IsSentOut}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="تكلفة الإرسال:" VerticalAlignment="Center" Margin="0,4,8,4" />
                        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4" Text="{Binding SentOutCostPrice}"
                                 IsEnabled="{Binding IsSentOut}" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="المدى المرجعي">
                <DockPanel Margin="8">
                    <Border DockPanel.Dock="Top" Background="#FFF8E1" BorderBrush="#E0C36A" BorderThickness="1"
                            Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="تعديل المدى لا يغيّر النتائج السابقة" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="أدخل نورمالات كل وحدة عمرية على حدة" Foreground="#666666" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="جديد" Width="80" Margin="0,0,8,0" Command="{Binding NewRangeCommand}" />
                        <Button Content="حفظ المدى" Width="100" Margin="0,0,8,0" Command="{Binding SaveRangeCommand}" />
                        <Button Content="حذف المدى" Width="90" Command="{Binding DeleteRangeCommand}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}"
                              AutoGenerateColumns="False" IsReadOnly="True" Height="180" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="من (سن)" Binding="{Binding AgeMin}" Width="60" />
                            <DataGridTextColumn Header="إلى (سن)" Binding="{Binding AgeMax}" Width="60" />
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding AgeUnit}" Width="60" />
                            <DataGridTextColumn Header="الجنس" Binding="{Binding Sex}" Width="70" />
                            <DataGridTextColumn Header="الأدنى" Binding="{Binding MinValue}" Width="70" />
                            <DataGridTextColumn Header="الأعلى" Binding="{Binding MaxValue}" Width="70" />
                            <DataGridTextColumn Header="تعليق منخفض" Binding="{Binding LowComment}" Width="*" />
                            <DataGridTextColumn Header="تعليق مرتفع" Binding="{Binding HighComment}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="السن من:" VerticalAlignment="Center" Margin="0,4,8,4" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding RangeAgeMin}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="السن إلى:" VerticalAlignment="Center" Margin="8,4,8,4" />
                        <TextBox Grid.Row="0" Grid.Column="3" Margin="0,4" Text="{Binding RangeAgeMax}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="الوحدة:" VerticalAlignment="Center" Margin="0,4,8,4" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" ItemsSource="{Binding AgeUnitOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RangeAgeUnit}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="الجنس:" VerticalAlignment="Center" Margin="8,4,8,4" />
                        <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,4" ItemsSource="{Binding SexOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RangeSex}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="الأدنى:" VerticalAlignment="Center" Margin="0,4,8,4" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding RangeMinValue}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="الأعلى:" VerticalAlignment="Center" Margin="8,4,8,4" />
                        <TextBox Grid.Row="2" Grid.Column="3" Margin="0,4" Text="{Binding RangeMaxValue}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="تعليق منخفض:" VerticalAlignment="Center" Margin="0,4,8,4" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding RangeLowComment}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="تعليق مرتفع:" VerticalAlignment="Center" Margin="8,4,8,4" />
                        <TextBox Grid.Row="3" Grid.Column="3" Margin="0,4" Text="{Binding RangeHighComment}" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="ربط المكوّنات">
                <StackPanel Margin="8">
                    <TextBlock Text="المكوّن المرتبط حالياً:" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding MappedAnalyteText}" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="اختر مكوّناً من القاموس:" Margin="0,0,0,2" />
                    <ComboBox ItemsSource="{Binding Analytes}" SelectedItem="{Binding SelectedAnalyte}"
                              DisplayMemberPath="Name" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="ربط" Width="90" Margin="0,0,8,0" Command="{Binding MapAnalyteCommand}" />
                        <Button Content="فك الربط" Width="90" Command="{Binding UnmapAnalyteCommand}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
