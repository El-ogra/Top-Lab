<UserControl x:Class="TopLab.Presentation.Views.Lab.AntibioticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Width="220" Margin="0,0,8,0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="بحث" Width="80" Margin="0,0,8,0" Command="{Binding SearchCommand}" />
            <Button Content="مضاد جديد" Width="100" Command="{Binding OpenCreateCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="لا مضادات في القاموس" Foreground="#666666" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#1E3A5F" Margin="0,4,0,0" />
        <TextBlock DockPanel.Dock="Bottom" Text="ملاحظة: لا يمكن حذف مضاد مرتبط بمزرعة — افكك الربط أولاً من شاشة الربط"
                   Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,0" />

        <DataGrid ItemsSource="{Binding Antibiotics}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*" />
                <DataGridCheckBoxColumn Header="معلَّم للحوامل" Binding="{Binding IsPregnancyFlagged}" Width="110" />
                <DataGridCheckBoxColumn Header="معلَّم للأطفال" Binding="{Binding IsChildrenFlagged}" Width="110" />
                <DataGridTemplateColumn Header="إجراءات" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="تعديل" Width="60" Margin="2"
                                        Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="حذف" Width="60" Margin="2"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
