<UserControl x:Class="TopLab.Presentation.Views.Attendance.UserAttendanceSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="16" MaxWidth="600" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filters -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="المستخدم:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding UserItems}"
                      SelectedValue="{Binding SelectedUserId}"
                      SelectedValuePath="Id"
                      DisplayMemberPath="UserName"
                      Width="140" Margin="0,0,8,0"/>
            <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding From, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,8,0"/>
            <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding To, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,8,0"/>
            <Button Content="عرض" Width="70" Margin="0,0,12,0" Command="{Binding LoadCommand}"/>
            <Button Content="رجوع" Width="70" Command="{Binding BackCommand}"/>
        </StackPanel>

        <!-- Loading -->
        <ProgressBar Grid.Row="1" Height="6" IsIndeterminate="True" Margin="0,0,0,8">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Summary cards -->
        <Border Grid.Row="2" Background="#F0F4F8" Padding="12" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="ملخص الحضور" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Summary.UserName, StringFormat='المستخدم: {0}'}"/>
                <TextBlock Text="{Binding Summary.DaysPresent, StringFormat='أيام الحضور: {0}'}"/>
                <TextBlock Text="{Binding Summary.RecordsCount, StringFormat='عدد السجلات: {0}'}"/>
                <TextBlock Text="{Binding Summary.TotalWorkedMinutes, StringFormat='إجمالي وقت العمل (دقيقة): {0}'}"/>
                <TextBlock Text="{Binding Summary.TotalLatenessMinutes, StringFormat='إجمالي التأخير (دقيقة): {0}'}"/>
                <TextBlock Text="{Binding Summary.TotalOvertimeMinutes, StringFormat='الإضافي (دقيقة): {0}'}"/>
            </StackPanel>
        </Border>

        <!-- Empty state -->
        <TextBlock Grid.Row="2" Text="اختر مستخدماً واضغط «عرض» لعرض الملخص." Foreground="#666666"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Error -->
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
