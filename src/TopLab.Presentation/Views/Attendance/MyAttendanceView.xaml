<UserControl x:Class="TopLab.Presentation.Views.Attendance.MyAttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <Grid Margin="20" MaxWidth="480" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="حضوري" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding CurrentUserName, StringFormat='المستخدم: {0}'}" FontSize="14" Foreground="#555555"/>
            <TextBlock Text="{Binding CurrentTimeText, StringFormat='الوقت: {0}'}" FontSize="14" Foreground="#555555"/>
        </StackPanel>

        <!-- Loading -->
        <ProgressBar Grid.Row="1" Height="6" IsIndeterminate="True" Margin="0,0,0,8">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Ready state (replaces Empty for this screen — no list to display) -->
        <TextBlock Grid.Row="2" Text="جاهز — اختر الإجراء المطلوب." Foreground="#666666" Margin="0,0,0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Action buttons -->
        <UniformGrid Grid.Row="3" Columns="2" Margin="0,0,0,8">
            <Button Content="تسجيل حضور" Height="48" Margin="4" Padding="12,6"
                    Command="{Binding CheckInCommand}" IsEnabled="{Binding CanCheckIn}"/>
            <Button Content="بدء استراحة" Height="48" Margin="4" Padding="12,6"
                    Command="{Binding StartBreakCommand}" IsEnabled="{Binding CanStartBreak}"/>
            <Button Content="إنهاء استراحة" Height="48" Margin="4" Padding="12,6"
                    Command="{Binding EndBreakCommand}" IsEnabled="{Binding CanEndBreak}"/>
            <Button Content="تسجيل انصراف" Height="48" Margin="4" Padding="12,6"
                    Command="{Binding CheckOutCommand}" IsEnabled="{Binding CanCheckOut}"/>
        </UniformGrid>

        <!-- Messages -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="Green" Margin="0,4,0,0"/>
        <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,20,0,0"/>

        <!-- Back -->
        <Button Grid.Row="5" Content="رجوع" Width="80" HorizontalAlignment="Right" Margin="0,8,0,0"
                Command="{Binding BackCommand}"/>
    </Grid>
</UserControl>
