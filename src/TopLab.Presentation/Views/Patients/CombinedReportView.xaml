<UserControl x:Class="TopLab.Presentation.Views.Patients.CombinedReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#F0F4F8" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{Binding PatientFullName}" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="{Binding LabId, StringFormat='الرقم المعملي: {0}'}" FontSize="13" Foreground="Gray"/>
                <TextBlock Text="{Binding SelectedCount, StringFormat='المحدد: {0}'}" FontSize="12" Foreground="#888888"/>
            </StackPanel>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="بناء المعاينة" Margin="0,0,6,0" Padding="10,5" Command="{Binding BuildPreviewCommand}"/>
            <Button Content="طباعة" Margin="0,0,6,0" Padding="10,5" Command="{Binding PrintCommand}"/>
            <Button Content="إدراج من التاريخ" Margin="0,0,6,0" Padding="10,5" Command="{Binding InsertFromHistoryCommand}"/>
            <Button Content="إدراج تلقائي" Margin="0,0,6,0" Padding="10,5" Command="{Binding AutoInsertCommand}"/>
            <Button Content="أعلى" Margin="0,0,6,0" Padding="10,5" Command="{Binding MoveUpCommand}"/>
            <Button Content="أسفل" Margin="0,0,6,0" Padding="10,5" Command="{Binding MoveDownCommand}"/>
            <Button Content="رجوع" Margin="0,0,6,0" Padding="10,5" Command="{Binding BackCommand}"/>
        </StackPanel>

        <!-- Loading -->
        <ProgressBar Grid.Row="2" Height="6" IsIndeterminate="True" Margin="0,0,0,8">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Content: Tests list + Preview -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Combinable tests -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="التحاليل القابلة للدمج" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock DockPanel.Dock="Top" Text="لا توجد تحاليل معتمدة قابلة للدمج لهذا المريض." Foreground="#666666" Margin="0,0,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowCombinableEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <DataGrid ItemsSource="{Binding CombinableTests}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="اختيار" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <DataGridTextColumn Header="التحليل" Binding="{Binding TestName}" Width="*"/>
                        <DataGridTextColumn Header="الرمز" Binding="{Binding TestCode}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Preview -->
            <DockPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="المعاينة" FontWeight="Bold" Margin="0,0,0,4"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Preview.PatientFullName}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Preview.LabId, StringFormat='الرقم المعملي: {0}'}" Foreground="Gray"/>
                        <ItemsControl ItemsSource="{Binding Preview.Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="6" Margin="0,2,0,0">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold">
                                                <Run Text="{Binding TestName, Mode=OneWay}"/>
                                                <Run Text=" — "/>
                                                <Run Text="{Binding ResultValue, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding FrozenRangeText}" Foreground="Gray" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- Messages -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="Green" Margin="0,4,0,0"/>
        <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </Grid>
</UserControl>
