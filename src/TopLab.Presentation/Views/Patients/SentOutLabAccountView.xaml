<UserControl x:Class="TopLab.Presentation.Views.Patients.SentOutLabAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Account Panel -->
        <Border Grid.Row="0" Background="#F0F4F8" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{Binding Account.ExternalLabName}" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="{Binding Account.SentCount, StringFormat='عدد العينات: {0}'}"/>
                <TextBlock Text="{Binding Account.TotalCost, StringFormat='التكلفة الإجمالية: {0}'}"/>
                <TextBlock Text="{Binding Account.TotalPaid, StringFormat='المدفوع: {0}'}"/>
                <TextBlock Text="{Binding Account.Remaining, StringFormat='المتبقي: {0}'}" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Payment controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="معرّف العينة:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding SelectedSampleId, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,8,0"/>
            <TextBlock Text="المبلغ:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding PaymentAmountText, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,8,0"/>
            <Button Content="تسجيل دفعة" Margin="0,0,6,0" Padding="10,5" Command="{Binding RecordPaymentCommand}"/>
            <Button Content="تسوية كاملة" Margin="0,0,6,0" Padding="10,5" Command="{Binding SettleInFullCommand}"/>
            <Button Content="رجوع" Padding="10,5" Command="{Binding BackCommand}"/>
        </StackPanel>

        <!-- Loading -->
        <ProgressBar Grid.Row="2" Height="6" IsIndeterminate="True" Margin="0,0,0,8">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Empty state -->
        <TextBlock Grid.Row="3" Text="لا توجد معامل خارجية مسجلة — أضف جهة بنوع «معمل خارجي» من إدارة الجهات." Foreground="#666666"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Messages -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="Green" Margin="0,4,0,0"/>
        <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </Grid>
</UserControl>
