<Window x:Class="TopLab.Presentation.Views.Patients.InsertHistoryDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدراج نتيجة تاريخية" Height="400" Width="550"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="إدراج" Width="90" Margin="0,0,8,0" Click="InsertButton_Click" IsDefault="True"/>
            <Button Content="إلغاء" Width="80" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel>
            <TextBlock Text="{Binding TargetTestName, StringFormat='التحليل المستهدف: {0}'}" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="لا نتائج تاريخية لهذا التحليل." Foreground="#666666" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <DataGrid ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التحليل" Binding="{Binding TestName}" Width="*"/>
                    <DataGridTextColumn Header="النتيجة" Binding="{Binding ResultValue}" Width="80"/>
                    <DataGridCheckBoxColumn Header="مُعتمد" Binding="{Binding IsReviewed}" Width="60"/>
                    <DataGridTextColumn Header="تاريخ الإدخال" Binding="{Binding EnteredAtUtc, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DockPanel>
</Window>
