<Window x:Class="TopLab.Presentation.Views.Patients.TestCommentPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعليق" Height="360" Width="460"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="اختيار" Width="90" Margin="0,0,8,0" Click="PickButton_Click" IsDefault="True"/>
            <Button Content="إلغاء" Width="80" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel>
            <TextBlock Text="{Binding TestName}" FontWeight="Bold" Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding Comments}" SelectedItem="{Binding SelectedComment}"
                     DisplayMemberPath="CommentText" Height="200" Margin="0,0,0,8"/>
        </StackPanel>
    </DockPanel>
</Window>
