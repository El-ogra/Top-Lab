<UserControl x:Class="TopLab.Presentation.Views.Patients.PatientSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <DockPanel Margin="16">
        <!-- Top: Search + LabId + Actions -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="بحث:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"/>
            <Button Content="بحث" Width="70" Margin="0,0,12,0" Command="{Binding SearchCommand}"/>

            <TextBlock Text="كود المعمل:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding LabIdText, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0"/>
            <Button Content="جلب بالكود" Width="90" Margin="0,0,12,0" Command="{Binding FetchByLabIdCommand}"/>

            <Button Content="رجوع" Width="70" Command="{Binding BackCommand}"/>
        </StackPanel>

        <!-- Paging -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock Text="{Binding Page, StringFormat='صفحة {0}'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="السابق" Width="70" Margin="0,0,6,0" Command="{Binding PreviousPageCommand}"/>
            <Button Content="التالي" Width="70" Command="{Binding NextPageCommand}"/>
        </StackPanel>

        <!-- Loading -->
        <ProgressBar DockPanel.Dock="Top" Height="6" IsIndeterminate="True" Margin="0,4,0,0">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Error -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <!-- Empty state -->
        <TextBlock DockPanel.Dock="Top" Text="لا توجد نتائج مطابقة." Foreground="#666666" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Results Grid -->
        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowHeaderWidth="0"
                  Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الاسم" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Lab ID" Binding="{Binding LabId}" Width="80"/>
                <DataGridTextColumn Header="اللقب" Binding="{Binding Title}" Width="60"/>
                <DataGridTextColumn Header="الجنس" Binding="{Binding Sex}" Width="60"/>
                <DataGridTextColumn Header="العمر" Binding="{Binding AgeValue}" Width="50"/>
                <DataGridTextColumn Header="وحدة العمر" Binding="{Binding AgeUnit}" Width="70"/>
                <DataGridTextColumn Header="الرقم الوطني" Binding="{Binding NationalId}" Width="100"/>
                <DataGridTextColumn Header="نوع الحساب" Binding="{Binding AccountType}" Width="80"/>
                <DataGridCheckBoxColumn Header="VIP" Binding="{Binding IsVip}" Width="50"/>
                <DataGridTextColumn Header="الحالة" Binding="{Binding AggregateStatus}" Width="60"/>
                <DataGridTextColumn Header="التاريخ" Binding="{Binding RegistrationDateUtc, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                <DataGridTextColumn Header="عدد التحاليل" Binding="{Binding TestCount}" Width="80"/>
                <DataGridTemplateColumn Header="فتح" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="فتح" Padding="6,2"
                                    Command="{Binding DataContext.OpenPatientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
