<UserControl x:Class="TopLab.Presentation.Views.Patients.PatientSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <DockPanel Margin="16">
        <!-- Top: Search + LabId + Actions -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="بحث:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"/>
            <Button Content="بحث" Width="70" Margin="0,0,12,0" Command="{Binding SearchCommand}"/>

            <TextBlock Text="كود المعمل:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding LabIdText, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0"/>
            <Button Content="جلب بالكود" Width="90" Margin="0,0,12,0" Command="{Binding FetchByLabIdCommand}"/>
            <Button Content="الفرع" Width="70" Margin="0,0,12,0" Command="{Binding BranchFilterNoticeCommand}"/>
            <Button Content="رجوع" Width="70" Command="{Binding BackCommand}"/>
        </StackPanel>

        <!-- P-01 F1–F5 filter region: SIX distinct controls (C-2). -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <!-- F1a — treating doctor. Separate control, separate label, separate lookup (SD-6). -->
            <TextBlock Text="الطبيب المعالج:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="150" Margin="0,0,12,0"
                      ItemsSource="{Binding TreatingDoctorOptions}"
                      SelectedItem="{Binding SelectedTreatingDoctor}"
                      DisplayMemberPath="Name"/>
            <!-- F1b — referral entity (an institution). Never merged with the control above (SD-6). -->
            <TextBlock Text="جهة الإحالة:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="150" Margin="0,0,12,0"
                      ItemsSource="{Binding ReferralEntityOptions}"
                      SelectedItem="{Binding SelectedReferralEntity}"
                      DisplayMemberPath="Name"/>
            <!-- F2 — by test -->
            <TextBlock Text="التحليل:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="150" Margin="0,0,12,0"
                      ItemsSource="{Binding TestOptions}"
                      SelectedItem="{Binding SelectedTest}"
                      DisplayMemberPath="Name"/>
            <!-- F3 — by gender -->
            <TextBlock Text="الجنس:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="90" Margin="0,0,12,0"
                      ItemsSource="{Binding SexOptions}"
                      SelectedItem="{Binding SelectedSex}"
                      DisplayMemberPath="Label"/>
            <!-- F4 — age band. Like with like: the unit applies to both the band and the stored value. -->
            <TextBlock Text="العمر:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding AgeFrom, UpdateSourceTrigger=LostFocus}" Width="45" Margin="0,0,4,0"/>
            <TextBlock Text="إلى" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding AgeTo, UpdateSourceTrigger=LostFocus}" Width="45" Margin="0,0,6,0"/>
            <ComboBox Width="70" Margin="0,0,12,0"
                      ItemsSource="{Binding AgeUnitOptions}"
                      SelectedItem="{Binding SelectedAgeUnit}"
                      DisplayMemberPath="Label"/>
            <!-- F5 — registration date range, inclusive on both ends -->
            <TextBlock Text="من تاريخ:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding FromDate}" Width="120" Margin="0,0,8,0"/>
            <TextBlock Text="إلى تاريخ:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding ToDate}" Width="120" Margin="0,0,12,0"/>

            <Button Content="مسح الفلاتر" Width="90" Margin="0,0,12,0" Command="{Binding ClearFiltersCommand}"/>
        </StackPanel>

        <!-- Paging -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock Text="{Binding Page, StringFormat='صفحة {0}'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="السابق" Width="70" Margin="0,0,6,0" Command="{Binding PreviousPageCommand}"/>
            <Button Content="التالي" Width="70" Command="{Binding NextPageCommand}"/>
        </StackPanel>

        <!-- Loading -->
        <ProgressBar DockPanel.Dock="Top" Height="6" IsIndeterminate="True" Margin="0,4,0,0">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Error -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <!-- Empty state -->
        <TextBlock DockPanel.Dock="Top" Text="لا توجد نتائج مطابقة." Foreground="#666666" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Results Grid -->
        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowHeaderWidth="0"
                  Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الاسم" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Lab ID" Binding="{Binding LabId}" Width="80"/>
                <DataGridTextColumn Header="اللقب" Binding="{Binding Title}" Width="60"/>
                <DataGridTextColumn Header="الجنس" Binding="{Binding Sex}" Width="60"/>
                <DataGridTextColumn Header="العمر" Binding="{Binding AgeValue}" Width="50"/>
                <DataGridTextColumn Header="وحدة العمر" Binding="{Binding AgeUnit}" Width="70"/>
                <DataGridTextColumn Header="الرقم الوطني" Binding="{Binding NationalId}" Width="100"/>
                <DataGridTextColumn Header="نوع الحساب" Binding="{Binding AccountType}" Width="80"/>
                <DataGridCheckBoxColumn Header="VIP" Binding="{Binding IsVip}" Width="50"/>
                <DataGridTextColumn Header="الحالة" Binding="{Binding AggregateStatus}" Width="60"/>
                <DataGridTextColumn Header="التاريخ" Binding="{Binding RegistrationDateUtc, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                <DataGridTextColumn Header="عدد التحاليل" Binding="{Binding TestCount}" Width="80"/>
                <DataGridTemplateColumn Header="فتح" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="فتح" Padding="6,2"
                                    Command="{Binding DataContext.OpenPatientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
