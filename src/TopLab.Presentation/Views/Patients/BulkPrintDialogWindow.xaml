<Window x:Class="TopLab.Presentation.Views.Patients.BulkPrintDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الطباعة الجماعية" Height="480" Width="650"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <!-- Bottom buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="تنفيذ الطباعة" Width="120" Margin="0,0,8,0"
                    Click="ExecuteButton_Click" IsDefault="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsExecuted}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="إغلاق" Width="80" Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>

        <!-- Status messages -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="Green" Margin="0,8,0,0"/>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <!-- Loading -->
        <ProgressBar DockPanel.Dock="Top" Height="6" IsIndeterminate="True" Margin="0,0,0,8">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="المرضى المؤهلون للطباعة:" FontWeight="Bold" Margin="0,0,0,4"/>
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding PreflightItems}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="المريض" Binding="{Binding PatientFullName}" Width="*"/>
                    <DataGridTextColumn Header="المعتمدة" Binding="{Binding VerifiedCount}" Width="80"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalCount}" Width="80"/>
                    <DataGridCheckBoxColumn Header="إعادة طباعة؟" Binding="{Binding RequiresReprintConfirmation}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="نتائج الطباعة:" FontWeight="Bold" Margin="0,8,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOutcomes}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <DataGrid Grid.Row="3"
                      ItemsSource="{Binding Outcomes}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      RowHeaderWidth="0">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOutcomes}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="معرّف المريض" Binding="{Binding PatientId}" Width="100"/>
                    <DataGridTextColumn Header="النتيجة" Binding="{Binding Outcome}" Width="*"/>
                    <DataGridTextColumn Header="العدد المطبوع" Binding="{Binding PrintedCount}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
