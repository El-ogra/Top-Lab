<UserControl x:Class="TopLab.Presentation.Views.Patients.PatientEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <DockPanel LastChildFill="True">
        <!-- S-03 Slice 0: visible loading indicator bound to IsBusy (S-01/S-02 DataTrigger idiom). -->
        <ProgressBar DockPanel.Dock="Top" Height="6" IsIndeterminate="True" Margin="8,4,8,0">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>
        <!-- Bottom strip: billing summary + payment + actions -->
        <StackPanel DockPanel.Dock="Bottom" Margin="8,4">
            <Separator />
            <WrapPanel>
                <TextBlock Text="إجمالي التحاليل:" Margin="4" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalCharged}" Margin="0,4,8,4" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBlock Text="الخصم:" Margin="4" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalDiscount}" Margin="0,4,8,4" VerticalAlignment="Center" />
                <TextBlock Text="المدفوع:" Margin="4" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalPaid}" Margin="0,4,8,4" VerticalAlignment="Center" />
                <TextBlock Text="الباقي:" Margin="4" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Balance}" Margin="0,4,8,4" VerticalAlignment="Center" FontWeight="Bold" />
                <Button Content="عرض الحساب" Margin="8,4,4,4" Padding="10,2" Command="{Binding OpenAccountCommand}" />
                <TextBlock Text="دفعة:" Margin="8,4,4,4" VerticalAlignment="Center" />
                <TextBox Text="{Binding PaymentAmountText, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,4">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AccountEntryEnterCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="خصم:" Margin="8,4,4,4" VerticalAlignment="Center" />
                <TextBox Text="{Binding PaymentDiscountText, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,4">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AccountEntryEnterCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="%" Margin="8,4,4,4" VerticalAlignment="Center" />
                <TextBox Text="{Binding PaymentPercentageText, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,4">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AccountEntryEnterCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="تسجيل مدفوع" Margin="8,4,4,4" Padding="10,2" Command="{Binding RecordPaymentCommand}" />
                <Button Content="تسوية كاملة" Margin="4" Padding="10,2" Command="{Binding SettleCommand}" />
                <TextBlock Text="استرداد:" Margin="8,4,4,4" VerticalAlignment="Center" />
                <TextBox Text="{Binding RefundAmountText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,4" />
                <Button Content="استرداد" Margin="4" Padding="10,2" Command="{Binding RefundCommand}" />
                <Button Content="تصفير الحساب" Margin="4" Padding="10,2" Command="{Binding ClearAccountCommand}" />
            </WrapPanel>
            <WrapPanel>
                <Button Content="جديد" Margin="4" Padding="14,2" Command="{Binding NewPatientCommand}" />
                <Button Content="حفظ" Margin="4" Padding="14,2" Command="{Binding SaveCommand}" />
                <Button Content="حذف" Margin="4" Padding="14,2" Command="{Binding DeleteCommand}" />
                <Button Content="تراجع" Margin="4" Padding="14,2" Command="{Binding UndoCommand}" />
                <Separator Margin="8,0" />
                <Button Content="باركود" Margin="4" Padding="14,2" Command="{Binding PrintBarcodeCommand}" />
                <Button Content="ورقة العمل" Margin="4" Padding="14,2" Command="{Binding PrintWorkSheetCommand}" />
                <Button Content="الإيصال" Margin="4" Padding="14,2" Command="{Binding PrintReceiptCommand}" />
                <Button Content="الفاتورة" Margin="4" Padding="14,2" Command="{Binding PrintInvoiceCommand}" />
                <Button Content="طلب تحاليل" Margin="4" Padding="14,2" Command="{Binding PrintLabOrderCommand}" />
<Button Content="مغلف" Margin="4" Padding="14,2" Command="{Binding PrintEnvelopeCommand}" IsEnabled="{Binding IsEditMode}" />
  <Button Content="نافذة المرضى" Margin="4" Padding="14,2" Command="{Binding PatientWindowCommand}" />
  <Button Content="نتائج التحاليل" Margin="4" Padding="14,2" Command="{Binding LabResultsCommand}" IsEnabled="{Binding IsEditMode}" />
  <Button Content="متابعة" Margin="4" Padding="14,2" Command="{Binding FollowUpCommand}" IsEnabled="{Binding IsEditMode}" />
  <Button Content="يحتاج متابعة" Margin="4" Padding="14,2" Command="{Binding ToggleFollowUpFlagCommand}" IsEnabled="{Binding IsEditMode}" />
  <Button Content="إحصائيات اليوم" Margin="4" Padding="14,2" Command="{Binding ShowTodayStatsCommand}" />
  <Button Content="قصاصة تعريف" Margin="4" Padding="14,2" Command="{Binding PrintPatientIdSlipCommand}" IsEnabled="{Binding IsEditMode}" />
</WrapPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="4,2" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#1E3A5F" TextWrapping="Wrap" Margin="4,0" />
        </StackPanel>

        <!-- Main area: form (right) + tests (left) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Right: demographics form -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="8,4">
                <StackPanel>
                    <!-- S-03 Slice 1: search-to-edit section (consumes SearchPatientsQuery). -->
                    <TextBlock Text="بحث عن مريض" FontSize="16" Margin="0,0,0,8" />
                    <WrapPanel>
                        <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="2" />
                        <Button Content="بحث" Margin="2" Padding="14,2" Command="{Binding SearchPatientsCommand}" />
                        <Button Content="مسح" Margin="2" Padding="14,2" Command="{Binding ClearSearchCommand}" />
                    </WrapPanel>
                    <TextBlock Text="الاسم / الرقم القومي / Lab.ID / الهاتف" Foreground="#666666" Margin="2,0,2,4" />
                    <TextBlock Text="لا نتائج مطابقة." Foreground="#666666" Margin="2,0,2,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowSearchEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListView ItemsSource="{Binding SearchResults}" Height="120" Margin="0,0,0,4">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="فتح" Margin="2" Padding="8,0"
                                            Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="{Binding FullName}" Margin="4,2" VerticalAlignment="Center" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                        <Setter Property="Foreground" Value="Gray" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="(محذوف)" Margin="4,2" VerticalAlignment="Center" Foreground="Red">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding LabId}" Margin="4,2" VerticalAlignment="Center" Foreground="#666666" />
                                    <TextBlock Text="{Binding PrimaryPhone}" Margin="4,2" VerticalAlignment="Center" Foreground="#666666" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <WrapPanel>
                        <Button Content="السابق" Margin="2" Padding="10,2" Command="{Binding PrevSearchPageCommand}" />
                        <TextBlock Text="{Binding SearchPage}" Margin="6,2" VerticalAlignment="Center" />
                        <Button Content="التالي" Margin="2" Padding="10,2" Command="{Binding NextSearchPageCommand}" />
                    </WrapPanel>
                    <Separator Margin="0,8" />
                    <TextBlock Text="بيانات المريض" FontSize="16" Margin="0,0,0,8" />
                    <!-- STAGE-01 (baseline 1.2.2.1.1 / 1.2.2.1.2): the visit dates of the patient header block. -->
                    <TextBlock Text="تواريخ الزيارة" FontWeight="Bold" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="تاريخ الدخول:" Margin="2" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RegistrationDateText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="2" ToolTip="تاريخ ووقت دخول المريض (yyyy-MM-dd HH:mm)" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="تاريخ الاستلام:" Margin="2" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PickupDateText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="2" ToolTip="تاريخ ووقت استلام النتيجة (yyyy-MM-dd HH:mm)" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="كود المريض:" Margin="2" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PatientIdText}" Margin="2" IsReadOnly="True" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Lab.ID:" Margin="2" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding LabId, UpdateSourceTrigger=PropertyChanged}" Margin="2" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="الاسم:" Margin="2" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Margin="2" />
                        <CheckBox Grid.Row="1" Grid.Column="3" Content="VIP" IsChecked="{Binding IsVip}" Margin="2" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="اللقب:" Margin="2" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Titles}" Margin="2" />
                        <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Content="ذكر (غير محدد = أنثى)" IsChecked="{Binding IsMale}" Margin="2" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="العمر:" Margin="2" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AgeValue, UpdateSourceTrigger=PropertyChanged}" Margin="2" />
                        <ComboBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" ItemsSource="{Binding AgeUnits}"
                                  SelectedItem="{Binding AgeUnit}" Margin="2" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="الهاتف:" Margin="2" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Margin="2" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="الرقم القومي:" Margin="2" VerticalAlignment="Center" />
                        <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding NationalId, UpdateSourceTrigger=PropertyChanged}" Margin="2" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="العنوان:" Margin="2" VerticalAlignment="Center" />
                        <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="2" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="نوع الحساب:" Margin="2" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding AccountTypes}"
                                  SelectedItem="{Binding AccountType}" Margin="2" />

                        <!-- STAGE-01 (baseline 1.2.2.2.6): the patient's card / file number. -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="رقم بطاقة / الملف:" Margin="2" VerticalAlignment="Center" />
                        <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="2" MaxLength="30" />

                        <!-- STAGE-01 (baseline 1.2.2.2.8): read-only summary of the visit's sample types. -->
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="نوع العينة:" Margin="2" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SampleTypeSummary}"
                                   Margin="2" VerticalAlignment="Center" Foreground="#666666"
                                   ToolTip="ملخص أنواع العينات المختارة في التحاليل المسجلة للزيارة." />
                    </Grid>

                    <TextBlock Text="الطبيب المعالج / جهة الإحالة" FontWeight="Bold" Margin="0,8,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="طبيب (رقم):" Margin="2" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TreatingDoctorIdText, UpdateSourceTrigger=PropertyChanged}" Margin="2" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TreatingDoctorName}" Margin="2" VerticalAlignment="Center" Foreground="#666666" />
                        <Button Grid.Row="0" Grid.Column="3" Content="اختيار طبيب" Margin="2" Padding="8,2" Command="{Binding PickTreatingDoctorCommand}" />
                        <Button Grid.Row="0" Grid.Column="4" Content="معلومات اضافية" Margin="2" Padding="8,2" Command="{Binding ShowTreatingDoctorDetailsCommand}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="إحالة (رقم):" Margin="2" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ReferralEntityIdText, UpdateSourceTrigger=PropertyChanged}" Margin="2" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ReferralEntityName}" Margin="2" VerticalAlignment="Center" Foreground="#666666" />
                        <Button Grid.Row="1" Grid.Column="3" Content="اختيار جهة" Margin="2" Padding="8,2" Command="{Binding PickReferralEntityCommand}" />
                        <Button Grid.Row="1" Grid.Column="4" Content="معلومات اضافية" Margin="2" Padding="8,2" Command="{Binding ShowReferralEntityDetailsCommand}" />
                    </Grid>

                    <!-- STAGE-01 (baseline 1.2.2.3): the medical-history block — the fasting pair,
                         the twelve catalogue toggles and the single imaging question. -->
                    <TextBlock Text="الصيام / الحالة الصحية" FontWeight="Bold" Margin="0,8,0,4" />
                    <WrapPanel>
                        <CheckBox Content="صائم" IsChecked="{Binding IsFastingIndicated}" Margin="2" VerticalAlignment="Center" />
                        <TextBlock Text="ساعات:" Margin="6,2,2,2" VerticalAlignment="Center" />
                        <TextBox Text="{Binding FastingHoursText, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="2" />
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding MedicationConditions}" Margin="0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The baseline's single imaging question (1.2.2.3.10) with its two answers. -->
                    <StackPanel Margin="0,4">
                        <TextBlock Text="هل تم عمل اشاعة بالصبغة او الموجات الصوتية خلال يومين" FontWeight="Bold" />
                        <WrapPanel>
                            <CheckBox Content="صبغة" IsChecked="{Binding RecentContrastImaging}" Margin="2" VerticalAlignment="Center" />
                            <CheckBox Content="موجات صوتية" IsChecked="{Binding RecentUltrasoundImaging}" Margin="2" VerticalAlignment="Center" />
                        </WrapPanel>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding ConditionToggles}" Margin="0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="ملاحظات:" Margin="0,4,0,0" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" Height="44"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                    <!-- STAGE-01 (baseline 1.2.2.4.2 / 1.2.2.4.2.1): the print-result password. -->
                    <TextBlock Text="كلمة مرور الطباعة" FontWeight="Bold" Margin="0,8,0,0" />
                    <WrapPanel>
                        <CheckBox Content="تفعيل كلمة مرور الطباعة" IsChecked="{Binding PrintResultPasswordEnabled}"
                                  Margin="2" VerticalAlignment="Center" />
                        <TextBlock Text="كلمة المرور:" Margin="8,2,2,2" VerticalAlignment="Center" />
                        <PasswordBox x:Name="PrintResultPasswordBox" Width="160" Margin="2"
                                     PasswordChanged="PrintResultPasswordBox_PasswordChanged" />
                        <Button Content="حفظ" Margin="4" Padding="10,2" Command="{Binding SavePrintResultPasswordCommand}" />
                    </WrapPanel>

                    <!-- S-03 Slice 2: read-only visit-history section (edit mode only, DTO fields only). -->
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisitHistoryVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="سجل الزيارات" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="لا توجد زيارات سابقة." Foreground="#666666" Margin="2,0,2,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowVisitHistoryEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding VisitHistory}" Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="6" Margin="0,0,0,4">
                                        <StackPanel>
                                            <WrapPanel>
                                                <TextBlock Text="زيارة:" Margin="2" VerticalAlignment="Center" Foreground="#666666" />
                                                <TextBlock Text="{Binding PatientId}" Margin="0,2,4,2" VerticalAlignment="Center" FontWeight="Bold" />
                                                <TextBlock Text="{Binding LabId}" Margin="4,2" VerticalAlignment="Center" Foreground="#666666" />
                                                <TextBlock Text="{Binding RegistrationDateUtc}" Margin="4,2" VerticalAlignment="Center" Foreground="#666666" />
                                            </WrapPanel>
                                            <ItemsControl ItemsSource="{Binding Tests}" Margin="0,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,2">
                                                            <WrapPanel>
                                                                <TextBlock Text="{Binding TestName}" Margin="2" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding TestCode}" Margin="4,2" VerticalAlignment="Center" Foreground="#666666" />
                                                                <TextBlock Text="{Binding PriceAtOrderTime}" Margin="4,2" VerticalAlignment="Center" Foreground="#666666" />
                                                                <TextBlock Text="مسحوبة" Margin="4,2" VerticalAlignment="Center" Foreground="Green">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSampleDrawn}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding SampleDrawnAtUtc}" Margin="4,2" VerticalAlignment="Center" Foreground="#666666">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSampleDrawn}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </WrapPanel>
                                                            <WrapPanel>
                                                                <TextBlock Text="بول" Margin="2" Foreground="#666666">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsUrine}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="براز" Margin="2" Foreground="#666666">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsStool}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="دم" Margin="2" Foreground="#666666">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsBlood}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="مني" Margin="2" Foreground="#666666">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSemen}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="نخاعي" Margin="2" Foreground="#666666">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCsf}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="خارج المعمل" Margin="2" Foreground="#666666">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsTakenOutsideLab}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Left: test catalog + selected tests -->
            <DockPanel Grid.Column="1" Margin="8,4" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="التحاليل" FontSize="16" Margin="0,0,0,8" />
                <!-- S-03 Slice 3: orphaned-action wiring (edit mode; guards live in the VM). -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="إجراءات الزيارة:" FontWeight="Bold" Margin="0,4" />
                    <WrapPanel>
                        <TextBlock Text="بروفايل:" Margin="2" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                  DisplayMemberPath="Name" Width="160" Margin="2" />
                        <Button Content="إضافة" Margin="2" Padding="8,0" Command="{Binding AddProfileCommand}" />
                    </WrapPanel>
                    <WrapPanel>
                        <CheckBox Content="بول" IsChecked="{Binding ProfileIsUrine}" Margin="2" VerticalAlignment="Center" />
                        <CheckBox Content="براز" IsChecked="{Binding ProfileIsStool}" Margin="2" VerticalAlignment="Center" />
                        <CheckBox Content="دم" IsChecked="{Binding ProfileIsBlood}" Margin="2" VerticalAlignment="Center" />
                        <CheckBox Content="مني" IsChecked="{Binding ProfileIsSemen}" Margin="2" VerticalAlignment="Center" />
                        <CheckBox Content="نخاعي" IsChecked="{Binding ProfileIsCsf}" Margin="2" VerticalAlignment="Center" />
                        <CheckBox Content="خارج المعمل" IsChecked="{Binding ProfileIsTakenOutsideLab}" Margin="2" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="مجموعة:" Margin="2" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding CustomGroups}" SelectedItem="{Binding SelectedCustomGroup}"
                                  DisplayMemberPath="Name" Width="160" Margin="2" />
                        <Button Content="إضافة" Margin="2" Padding="8,0" Command="{Binding AddCustomGroupCommand}" />
                        <Button Content="مسح الكل" Margin="8,2,2,2" Padding="8,0" Command="{Binding ClearAllVisitTestsCommand}" IsEnabled="{Binding CanClearAllVisitTests}" />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="مجموعة تحاليل:" Margin="2" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding TestGroups}" SelectedItem="{Binding SelectedTestGroup}"
                                  DisplayMemberPath="Name" Width="160" Margin="2" />
                        <Button Content="إضافة مجموعة تحاليل" Margin="2" Padding="8,0" Command="{Binding AddTestGroupCommand}" />
                    </WrapPanel>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="تحاليل المريض:" FontWeight="Bold" Margin="0,4" />
                <TextBlock DockPanel.Dock="Top" Text="لا توجد تحاليل مختارة." Foreground="#666666" Margin="0,0,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSelectedTestsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListView DockPanel.Dock="Top" ItemsSource="{Binding SelectedTests}" Height="180" Margin="0,0,0,4">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✕" Margin="2" Padding="4,0"
                                        Command="{Binding DataContext.RemoveSelectedTestCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Text="{Binding TestName}" Margin="4,2" VerticalAlignment="Center" FontWeight="Bold" />
                                <CheckBox Content="بول" IsChecked="{Binding IsUrine}" Margin="2" VerticalAlignment="Center" />
                                <CheckBox Content="براز" IsChecked="{Binding IsStool}" Margin="2" VerticalAlignment="Center" />
                                <CheckBox Content="دم" IsChecked="{Binding IsBlood}" Margin="2" VerticalAlignment="Center" />
                                <CheckBox Content="مني" IsChecked="{Binding IsSemen}" Margin="2" VerticalAlignment="Center" />
                                <CheckBox Content="نخاعي" IsChecked="{Binding IsCsf}" Margin="2" VerticalAlignment="Center" />
                                <CheckBox Content="خارج المعمل" IsChecked="{Binding IsTakenOutsideLab}" Margin="2" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock DockPanel.Dock="Top" Text="كتالوج التحاليل:" FontWeight="Bold" Margin="0,4" />
                <!-- 1.2.2.5.1.1 «start»: the master test list's filter field. Narrows by name OR code. -->
                <!-- 1.2.2.5.1.2 «TM / TG / CG»: three mutually exclusive view-filter modes (D-02).
                     Radio buttons, so exactly one is active at any time; no code-behind. -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <RadioButton Content="TM" GroupName="CatalogMode" Margin="2,0,10,0" VerticalAlignment="Center"
                                 IsChecked="{Binding IsTmMode, Mode=TwoWay}"
                                 ToolTip="كل التحاليل" />
                    <RadioButton Content="TG" GroupName="CatalogMode" Margin="0,0,10,0" VerticalAlignment="Center"
                                 IsChecked="{Binding IsTgMode, Mode=TwoWay}"
                                 ToolTip="بحث بالاسم أو الكود" />
                    <RadioButton Content="CG" GroupName="CatalogMode" Margin="0,0,10,0" VerticalAlignment="Center"
                                 IsChecked="{Binding IsCgMode, Mode=TwoWay}"
                                 ToolTip="مجموعاتي المخصصة" />
                </WrapPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="بحث:" Margin="2" VerticalAlignment="Center" />
                    <TextBox Text="{Binding CatalogFilterText, UpdateSourceTrigger=PropertyChanged}"
                             Width="180" Margin="2"
                             IsEnabled="{Binding IsCatalogSearchEnabled}" />
                    <Button Content="مسح" Margin="2" Padding="8,0" Command="{Binding ClearCatalogFilterCommand}" />
                    <TextBlock Text="لا توجد تحاليل مطابقة للبحث." Foreground="#666666" Margin="6,2,2,2"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowCatalogFilterNoMatch}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top" Text="لا توجد تحاليل في الكتالوج." Foreground="#666666" Margin="0,0,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowCatalogEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListView ItemsSource="{Binding FilteredCatalogTests}" Margin="0,0,0,4">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="إضافة" Margin="2" Padding="8,0"
                                        Command="{Binding DataContext.AddTestToSelectionCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding Id}" />
                                <TextBlock Text="{Binding Name}" Margin="4,2" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PatientPrice}" Margin="4,2" VerticalAlignment="Center" Foreground="#666666" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
