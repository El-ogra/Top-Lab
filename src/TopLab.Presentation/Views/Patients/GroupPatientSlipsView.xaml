<UserControl x:Class="TopLab.Presentation.Views.Patients.GroupPatientSlipsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <DockPanel Margin="16">
        <!-- Filters -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding From, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,8,0"/>
            <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding To, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,8,0"/>
            <Button Content="عرض" Width="70" Margin="0,0,12,0" Command="{Binding LoadCommand}"/>
            <Button Content="رجوع" Width="70" Command="{Binding BackCommand}"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="تحديد الكل" Width="90" Margin="0,0,8,0" Command="{Binding SelectAllCommand}"/>
            <Button Content="إلغاء التحديد" Width="100" Margin="0,0,8,0" Command="{Binding ClearSelectionCommand}"/>
            <Button Content="طباعة القصاصات" Width="130" Margin="0,0,8,0" Command="{Binding GenerateCommand}"/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="عدد المحدد:"/>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding SelectedCount}"/>
        </StackPanel>

        <!-- Loading -->
        <ProgressBar DockPanel.Dock="Top" Height="6" IsIndeterminate="True" Margin="0,4,0,0">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Error -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <!-- Status -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#1B7F3B" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <!-- Empty state -->
        <TextBlock DockPanel.Dock="Top" Text="لا توجد نتائج غير مسلَّمة في هذه الفترة." Foreground="#666666" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Patient selection grid -->
        <DataGrid ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  RowHeaderWidth="0"
                  Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="تحديد" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="المريض" Binding="{Binding PatientFullName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Lab ID" Binding="{Binding LabId}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="التاريخ" Binding="{Binding RegistrationDateUtc, StringFormat={}{0:yyyy-MM-dd}}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="غير المسلَّم" Binding="{Binding UndeliveredCount}" Width="80" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
