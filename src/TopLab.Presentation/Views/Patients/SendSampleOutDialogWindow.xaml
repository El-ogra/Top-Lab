<Window x:Class="TopLab.Presentation.Views.Patients.SendSampleOutDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إرسال عينة خارجياً" Height="320" Width="420"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="إرسال" Width="90" Margin="0,0,8,0" Click="SendButton_Click" IsDefault="True"/>
            <Button Content="إلغاء" Width="80" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel>
            <TextBlock Text="{Binding TestName, StringFormat='التحليل: {0}'}" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="المعمل الخارجي:" Margin="0,0,0,2"/>
            <ComboBox ItemsSource="{Binding LabItems}"
                      SelectedItem="{Binding SelectedLabId}"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,8"/>
            <TextBlock Text="تكلفة المعمل (اختياري):" Margin="0,0,0,2"/>
            <TextBox Text="{Binding CostPriceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
            <TextBlock Text="سعر التحصيل (اختياري):" Margin="0,0,0,2"/>
            <TextBox Text="{Binding PatientPriceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
        </StackPanel>
    </DockPanel>
</Window>
