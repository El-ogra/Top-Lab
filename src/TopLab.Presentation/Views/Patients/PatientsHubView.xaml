<UserControl x:Class="TopLab.Presentation.Views.Patients.PatientsHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <StackPanel Margin="20" MaxWidth="640" HorizontalAlignment="Center">
        <TextBlock Text="المرضى" FontSize="20" Margin="0,0,0,4" />
        <TextBlock Text="{Binding HelpText}" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,16" />

        <UniformGrid Columns="2">
            <Button Content="إضافة وتعديل بيانات المرضى" Height="64" Margin="4" Padding="16,8"
                    Command="{Binding OpenAddEditPatientCommand}" IsEnabled="{Binding AddEditPatientEnabled}" />
            <Button Content="إدخال نتائج التحاليل" Height="64" Margin="4" Padding="16,8"
                    Command="{Binding OpenEnterResultsCommand}" IsEnabled="{Binding EnterResultsEnabled}" />
            <Button Content="بحث عن مريض" Height="64" Margin="4" Padding="16,8"
                    Command="{Binding OpenSearchPatientCommand}" IsEnabled="{Binding SearchPatientEnabled}" />
            <Button Content="تسليم نتائج المرضى" Height="64" Margin="4" Padding="16,8"
                    Command="{Binding OpenDeliverResultsCommand}" IsEnabled="{Binding DeliverResultsEnabled}" />
            <Button Content="تقرير فارغ" Height="64" Margin="4" Padding="16,8"
                    Command="{Binding OpenBlankReportCommand}" IsEnabled="{Binding BlankReportEnabled}" />
            <Button Content="تقارير التاريخ" Height="64" Margin="4" Padding="16,8"
                    Command="{Binding OpenHistoryReportsCommand}" IsEnabled="{Binding HistoryReportsEnabled}" />
        </UniformGrid>

        <!-- GAP-15 (1.2.1.4): period-list action — patients registered in a chosen period. -->
        <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="12" Margin="4,16,4,0">
            <StackPanel>
                <TextBlock Text="قائمة مرضى فترة" FontWeight="Bold" Margin="0,0,0,8" />
                <WrapPanel>
                    <TextBlock Text="من تاريخ:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding PeriodFrom}" Width="130" Margin="0,0,12,0" />
                    <TextBlock Text="إلى تاريخ:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding PeriodTo}" Width="130" Margin="0,0,12,0" />
                    <Button Content="عرض قائمة الفترة" Padding="14,4"
                            Command="{Binding OpenPeriodListCommand}" IsEnabled="{Binding PeriodListEnabled}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
