<Window x:Class="TopLab.Presentation.Views.Patients.AmendmentsLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سجل تعديلات البروفايل" Height="400" Width="650"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <Button DockPanel.Dock="Bottom" Content="إغلاق" Width="80" HorizontalAlignment="Right" Margin="0,8,0,0"
                Click="CloseButton_Click" IsCancel="True"/>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <TextBlock DockPanel.Dock="Top" Text="لا توجد تعديلات مسجلة" Foreground="#666666" Margin="0,0,0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DataGrid ItemsSource="{Binding Amendments}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="المستخدم" Binding="{Binding AmendedByUserId}" Width="80"/>
                <DataGridTextColumn Header="التاريخ" Binding="{Binding AmendedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130"/>
                <DataGridTextColumn Header="القيمة القديمة" Binding="{Binding OldResultValue}" Width="*"/>
                <DataGridTextColumn Header="القيمة الجديدة" Binding="{Binding NewResultValue}" Width="*"/>
                <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
