<Window x:Class="TopLab.Presentation.Views.Users.ChangeOwnPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغيير كلمة المرور" Height="300" Width="420"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="تغيير كلمة المرور الخاصة بك"
                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="الحالية:" VerticalAlignment="Center" Margin="0,0,12,8"/>
        <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="CurrentPasswordBox" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="الجديدة:" VerticalAlignment="Center" Margin="0,0,12,8"/>
        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="NewPasswordBox" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="تأكيد الجديدة:" VerticalAlignment="Center" Margin="0,0,12,8"/>
        <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="ConfirmPasswordBox" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,8"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="حفظ" Width="90" Padding="8,4" Margin="0,0,8,0" Click="SaveButton_Click" IsDefault="True"/>
            <Button Content="إلغاء" Width="80" Padding="8,4" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
