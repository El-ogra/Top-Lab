{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-sysprompt-override"],
  "model": "freetheai/fta-zai-glm-5.3-flash",
  "provider": {
    "freetheai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeTheAI",
      "options": {
        "baseURL": "https://api.freetheai.org/v1",
        "apiKey": "{file:~/opencode-secrets/freetheai.key}"
      },
      "models": {
        "fta-zai-glm-5.3-flash": {
          "id": "fta/zai/glm-5.3-flash",
          "name": "GLM-5.3-Flash (FreeTheAI)",
          "limit": { "context": 1000000, "output": 131000 }
        }
      }
    }
  }
}